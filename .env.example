# ── Batch upload API key ─────────────────────────────────────────────────
# Allows agents and external tools (e.g. Aldine's "Send to read_paper" button) to
# upload PDFs without a browser session, using Authorization: Bearer <key>.
# Leave unset to disable Bearer-token auth (cookie auth still works for all endpoints).
# READPAPER_UPLOAD_API_KEY=change-me-to-a-random-secret

# ── Authentication ───────────────────────────────────────────────────────
# Multiple users via AUTH_USERS:
#   AUTH_USERS=user1@example.com:password1,user2@example.com:password2
# 
# Unset to disable authentication and allow public access.
# 
# AUTH_USERS=user1@example.com:password1,user2@example.com:password2
# 
# Optional: custom secret key for JWT token signing (defaults to a dev key if not set).
# AUTH_SECRET_KEY=your-secret-key-change-in-production
# 
# Optional: session timeout in seconds (default 86400 = 24 hours).
# AUTH_SESSION_TIMEOUT_SECONDS=86400

# ── Claude API (recommended; these few lines are enough) ──────────────
# For a custom gateway, set BASE_URL + AUTH_TOKEN (Bearer auth).
ANTHROPIC_BASE_URL=https://your-gateway.example.com
ANTHROPIC_AUTH_TOKEN=your-auth-token-here

# For the official Anthropic API, use ANTHROPIC_API_KEY instead.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Optional: override the default model (default: claude-sonnet-4-6).
# CLAUDE_API_MODEL=claude-opus-4-8
# CLAUDE_API_TIMEOUT_SECONDS=1200
# CLAUDE_BASH_TIMEOUT_SECONDS=120

# ── Web search (shared by Codex and Claude) ───────────────────────────
# Default toggle for the web_search tool; the frontend can override it per request.
# Default false. If your gateway doesn't support web_search, keeping it false avoids a
# failed round-trip and fallback notice on every request.
# ENABLE_WEB_SEARCH=false

# ── Local paper search (fallback for Claude's web_search) ─────────────
# When web search is ON for a request but the gateway forbids the server-side web_search
# tool, the Claude backend falls back to a local, key-free academic search across arXiv,
# Semantic Scholar, OpenAlex, DBLP, and OpenReview instead of dropping to bash-only. It is
# never offered when the user turned web search off. Default on; set false to disable.
# ENABLE_PAPER_SEARCH_FALLBACK=true
# PAPER_SEARCH_SOURCES=arxiv,semantic_scholar,openalex,dblp,openreview
# PAPER_SEARCH_MAX_RESULTS=10
# PAPER_SEARCH_TIMEOUT_SECONDS=20
# Optional: raise Semantic Scholar's rate limit / join OpenAlex's polite pool.
# SEMANTIC_SCHOLAR_API_KEY=
# OPENALEX_MAILTO=you@example.com

# ── Codex backend (optional; ignore if you don't use Codex) ───────────
# SUB_POOL_URL=http://your-pool-host:8787
# SUB_POOL_KEY=cp-replace-me

# ── Server ────────────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8080
# APP_RELOAD=1   # enable uvicorn auto-reload during development
