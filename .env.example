# ── Claude API（推荐，仅需这几行）──────────────────────────────────
# 使用自定义网关时设置 BASE_URL + AUTH_TOKEN（Bearer 鉴权）
ANTHROPIC_BASE_URL=https://your-gateway.example.com
ANTHROPIC_AUTH_TOKEN=your-auth-token-here

# 直接使用官方 Anthropic API 时，改用 ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# 可选：覆盖默认模型（默认 claude-sonnet-4-6）
# CLAUDE_API_MODEL=claude-opus-4-8
# CLAUDE_API_TIMEOUT_SECONDS=1200
# CLAUDE_BASH_TIMEOUT_SECONDS=120

# ── 联网搜索（Codex 与 Claude 通用）───────────────────────────────
# web_search 工具默认开关；前端每次提问可逐次覆盖。默认 false。
# 若网关不支持 web_search，保持 false 可避免每次提问的失败往返与回退提示。
# ENABLE_WEB_SEARCH=false

# ── Codex 后端（可选，不使用 Codex 可忽略）──────────────────────
# SUB_POOL_URL=http://your-pool-host:8787
# SUB_POOL_KEY=cp-replace-me
