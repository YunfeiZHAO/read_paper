# ── Claude API (recommended; these few lines are enough) ──────────────
# For a custom gateway, set BASE_URL + AUTH_TOKEN (Bearer auth).
ANTHROPIC_BASE_URL=https://your-gateway.example.com
ANTHROPIC_AUTH_TOKEN=your-auth-token-here

# For the official Anthropic API, use ANTHROPIC_API_KEY instead.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Optional: override the default model (default: claude-sonnet-4-6).
# CLAUDE_API_MODEL=claude-opus-4-8
# CLAUDE_API_TIMEOUT_SECONDS=1200
# CLAUDE_BASH_TIMEOUT_SECONDS=120

# ── Web search (shared by Codex and Claude) ───────────────────────────
# Default toggle for the web_search tool; the frontend can override it per request.
# Default false. If your gateway doesn't support web_search, keeping it false avoids a
# failed round-trip and fallback notice on every request.
# ENABLE_WEB_SEARCH=false

# ── Codex backend (optional; ignore if you don't use Codex) ───────────
# SUB_POOL_URL=http://your-pool-host:8787
# SUB_POOL_KEY=cp-replace-me

# ── Server ────────────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8080
# APP_RELOAD=1   # enable uvicorn auto-reload during development
